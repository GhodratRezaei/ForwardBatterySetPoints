{
  "name": "battered-batteries-function",
  "version": "1.0.0",
  "private": true,
  "description": "Azure Function that forwards home-battery setpoints from Service Bus to the Battered Batteries API.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "watch": "tsc --watch",
    "prestart": "npm run build",
    "start": "func start",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm run typecheck:tests && npm test",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:architecture": "vitest run tests/architecture",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=artifacts/test-results.xml",
    "package": "node scripts/package.mjs",
    "dev:vendor": "node dev/mock-vendor.mjs",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@azure/functions": "4.16.2",
    "axios": "1.20.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "azure-functions-core-tools": "4.14.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
